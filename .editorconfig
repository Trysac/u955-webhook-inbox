# Factory-owned file: agents must not edit it. Layout of this repository; RuboCop (.rubocop.yml) enforces the Ruby
# style in the format and lint gates.
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false
